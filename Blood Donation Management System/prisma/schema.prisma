generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Donor {
  id             String    @id @default(uuid())
  fullName       String
  email          String    @unique
  phone          String
  landline       String?
  bloodType      String
  birthDate      DateTime?
  age            Int?
  weight         String?
  gender         String?
  medicalCondition String?
  profilePicture String?
  
  // Detailed Location
  region         String?
  city           String?
  subCity        String?
  woreda         String?
  kebele         String?
  street         String?
  homeNumber     String?
  location       String? // Formatted or GPS string
  
  // GPS Location
  latitude       Float?
  longitude      Float?

  // Additional Info
  fanNumber      String?   @unique
  hasDisability  String?
  disabilityType String?

  maritalStatus  String?
  idCardFront    String?
  idCardBack     String?

  // Appointment Details
  donationAppointmentDate DateTime?
  appointmentRegion      String?
  appointmentPlace       String?
  appointmentTime        String?

  lotteryId      String?
  status         String    @default("Pending")
  rejectionReason String?

  // System Stats
  lastDonation   DateTime?
  availability   String?   @default("ready")
  totalDonations Int       @default(0)
  impactScore    Int       @default(0)
  donations      Donation[]
  
  // Auth
  username       String?   @unique
  password       String?
  createdAt      DateTime  @default(now())
  lotteryWinners LotteryWinner[]
}

model Hospital {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  phone     String
  landline  String?
  
   // Contact
  contactDoctorName  String?
  contactDoctorPhone String?
  
  // Location
  region    String?
  city      String?
  subCity   String?
  woreda    String?
  kebele    String?
  street    String?
  location  String?

  // GPS Location
  latitude  Float?
  longitude Float?
  
  // License & Type
  licenseName   String?
  licenseNumber String?
  businessLicenseImage String?
  hospitalType  String? // 'Government Hospital' | 'Non-Government Hospital'
  
  idCardFront    String?
  idCardBack     String?
  
  // Auth
  username      String?   @unique
  password      String?
  
  profilePicture String?
  status         String @default("Pending") // Pending approval
  rejectionReason String?
  
  createdAt     DateTime  @default(now())

  requests  Request[]
  donations Donation[]
}

model Request {
  id          String   @id @default(uuid())
  hospital    Hospital @relation(fields: [hospitalId], references: [id])
  hospitalId  String
  patient     String?
  bloodType   String
  urgency     String
  unitsNeeded Int
  status      String
  rejectionReason String?
  requestedAt DateTime @default(now())
  createdAt   DateTime @default(now())
}

model Donation {
  id           String   @id @default(uuid())
  donor        Donor    @relation(fields: [donorId], references: [id])
  donorId      String
  hospital     Hospital @relation(fields: [hospitalId], references: [id])
  hospitalId   String
  units        Int
  donationDate DateTime @default(now())
  status       String
  createdAt    DateTime @default(now())
}

model Inventory {
  id                String   @id @default(uuid())
  bloodType         String
  unitsAvailable    Int
  criticalThreshold Int
  lastUpdated       DateTime @default(now())
  createdAt         DateTime @default(now())
}

model Admin {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  fullName  String
  email     String   @unique
  phone     String?
  role      String   @default("admin") // 'admin' or 'super_admin'
  
  // Profile & Status
  profilePicture String?
  status         String    @default("active") // 'active' | 'inactive'
  
  // Address / Location
  region         String?
  city           String?
  subCity        String?
  woreda         String?
  kebele         String?
  street         String?
  homeNumber     String?
  
  // Personal Info
  bloodType      String?
  birthDate      DateTime?
  age            Int?
  gender         String?
  maritalStatus  String?
  fanNumber      String?
  idCardFront    String?
  idCardBack     String?
  landline       String?
  
  // GPS
  location       String?   // GPS string if needed
  latitude       Float?
  longitude      Float?
  activityLogs   AdminActivityLog[]

  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  message   String
  type      String
  relatedId String?
  forRole   String?
  userId    String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model LotteryWinner {
  id        String   @id @default(uuid())
  donor     Donor    @relation(fields: [donorId], references: [id])
  donorId   String
  tierName  String
  points    Int
  month     DateTime
  award     String
  createdAt DateTime @default(now())
}

model Staff {
  id        String   @id
  username  String?
  fullName  String
  email     String   @unique
  phone     String?
  landline  String?
  role      String?
  status    String?
  password  String?
  profilePicture String?
  bloodType String?
  birthDate DateTime?
  age       Int?
  maritalStatus String?
  gender    String?
  fanNumber String?
  idCardFront String?
  idCardBack String?
  medicalCondition String?
  hasDisability String?
  disabilityType String?
  region    String?
  city      String?
  subCity   String?
  woreda    String?
  kebele    String?
  street    String?
  homeNumber String?
  location  String?
  latitude  Float?
  longitude Float?
  createdAt DateTime @default(now())
}

model AdminActivityLog {
  id         String   @id @default(uuid())
  admin      Admin    @relation(fields: [adminId], references: [id])
  adminId    String
  actionType String
  targetId   String?
  targetName String?
  details    String?
  createdAt  DateTime @default(now())
}
